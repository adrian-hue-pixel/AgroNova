# Copy this file to .streamlit/secrets.toml for local use (that file is git-ignored).
# On Streamlit Community Cloud paste the same lines into: App -> Settings -> Secrets.

GEMINI_API_KEY = ""

# Optional: change the model without editing code.
# GEMINI_MODEL = "gemini-3.5-flash-lite"

# Optional: free key from https://data.gov.in for official Indian mandi prices (Market Prices page).
# DATA_GOV_IN_API_KEY = "paste-your-data-gov-in-key-here"

# Optional: auto-save the farm to data/farm_data.json. Use ONLY when the app runs on one device
# (on a shared public server every visitor would share the same file).
# LOCAL_SAVE = "true"
